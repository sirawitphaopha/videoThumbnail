# ของที่สร้างใหม่ได้
node_modules/
dist/
src-tauri/target/
src-tauri/gen/schemas/

# 🔴 สกิลกับบันทึกของ Claude ห้ามขึ้น git
# ที่เก็บบน GitHub เป็นแบบสาธารณะ ข้างในมีบันทึกส่วนตัวของพี่กันและเรื่องระบบโรงพยาบาล (ผลตรวจขั้น 0 ข้อ 1)
.claude/

# เครื่องมือแตกจาก vendor ด้วย scripts/fetch-tools.ps1 (ใหญ่ราว 540 MB)
src-tauri/tools/*.exe
src-tauri/tools/*.dll
src-tauri/tools/*.DLL
src-tauri/tools/*.zip
# SUPer ตัวสร้าง PGS แบบมาตรฐาน Blu-ray ทั้งโฟลเดอร์ราว 300 MB (fetch-tools แตกจาก vendor/super)
src-tauri/tools/super/
# SeConv ตัวแปลงซับแบบบรรทัดคำสั่งของ Subtitle Edit ตัวสร้าง PGS ตัวที่สาม (fetch-tools แตกจาก vendor/seconv)
src-tauri/tools/seconv/
# BDSup2Sub++ ตัวแปลงซับภาพเป็นซับภาพ (BUGS ข้อ 125 · fetch-tools แตกจาก vendor/bdsup2sub)
src-tauri/tools/bdsup2sub/

# ไฟล์ทดสอบ สร้างใหม่ด้วย scripts/make-test-media.mjs · มีไฟล์ส่วนตัวของพี่กัน
# ยกเว้น test-media/src ที่เขียนด้วยมือ สคริปต์สร้างไฟล์ทดสอบต้องใช้ สร้างใหม่ไม่ได้
test-media/*
!test-media/src/
!test-media/README.md

# ไฟล์บีบอัดของเครื่องมือ ใหญ่ เก็บแค่ README
vendor/**/*.7z
vendor/**/*.zip
vendor/**/*.tar.xz
vendor/**/*.sig
vendor/**/*.exe
vendor/**/*.conda
vendor/เทียบ-ffmpeg/
vendor/bitrate-viewer-ภาพอ้างอิง/

# ภาพหน้าจอที่มีรูปส่วนตัวของพี่กัน (รูป HEIC จากไอโฟน) เก็บไว้ในเครื่องเท่านั้น ห้ามขึ้น git · ที่เก็บบน GitHub เป็นแบบสาธารณะ
docs/report-*/**/*HEIC*.png
